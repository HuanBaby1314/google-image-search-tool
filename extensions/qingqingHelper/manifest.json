{
  "manifest_version": 3,
  "name": "Google Image Search Tool",
  "version": "1.0.0",
  "description": "批量下载图片并上传到Google搜图",
  "permissions": [
    "activeTab",
    "downloads",
    "storage",
    "tabs",
    "scripting",
    "tabGroups",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}